  "embeddedFormula": {
    "author": "Daniel White & Paul Nylander",
    "category": "Power / Quaternion",
    "defaultColorIterations": 18,
    "defaultIterations": 18,
    "description": "Classic Mandelbulb packaged as an embedded Threshold formula. The distance estimator is carried inline inside the .threshscene payload, so the scene loads through the custom .threshfx runtime path without needing a separate bundled shader file.",
    "functionStem": "EmbeddedMandelbulb",
    "id": "com.puppypower.threshold.embedded.mandelbulb",
    "metalSource": "FORCE_INLINE float DE_EmbeddedMandelbulb(float3 pos, FormulaParams fp, float3x3 rot,\n                                         int iterations, int colorIterations,\n                                         thread OrbitData& orbit) {\n    float power = clamp(fp.params[0], 2.0f, 32.0f);\n    float bailout = max(fp.params[1], 1.0f);\n    float dBias = max(fp.params[2], 0.01f);\n    float polarRot = fp.params[4];\n    bool applyRot = hasRot1Precomputed(fp);\n\n    float3 z = pos;\n    float3 c = pos;\n    float dr = 1.0f;\n    float r2 = dot(z, z);\n    float trap = 1e20f;\n    int trapIter = 0;\n    float3 trapPos = z;\n    const float minR2Exit = 1e-12f;\n    float bailout2 = bailout * bailout;\n    int i = 0;\n\n    for (; i < iterations && r2 < bailout2 && r2 > minR2Exit; ++i) {\n        float invR = fast::rsqrt(r2 + 1e-6f);\n        float theta = fast::asin(clamp11(z.z * invR)) + polarRot;\n        float phi = fast::atan2(z.y, z.x);\n        float rn = fastPowFromR2(r2, power);\n        dr = fma(rn * power * invR, dr, 1.0f);\n        float thetaP = theta * power;\n        float phiP = phi * power;\n        float cTheta, cPhi;\n        float sTheta = sincos(thetaP, cTheta);\n        float sPhi = sincos(phiP, cPhi);\n        z = rn * float3(cTheta * cPhi, cTheta * sPhi, sTheta) + c;\n        if (applyRot) z = rot * z;\n        r2 = dot(z, z);\n        UpdateTrapMinR2(trap, trapIter, trapPos, r2, i, colorIterations, z);\n    }\n\n    orbit.trap = trap;\n    orbit.trapIteration = trapIter;\n    orbit.trapPosition = trapPos;\n    orbit.finalP = z;\n    orbit.iterationsUsed = i;\n\n    float r = fast::sqrt(r2);\n    float safeR = max(r, 1e-6f);\n    float de = dBias * 0.5f * safeR * fast::log2(safeR) / max(dr, kEpsLen) * kLn2;\n    if (r > bailout) de = min(de, r - bailout * 0.9f);\n    return de;\n}\n\nFORCE_INLINE float DE_EmbeddedMandelbulb_Dist(float3 pos, FormulaParams fp, float3x3 rot, int iterations) {\n    float power = clamp(fp.params[0], 2.0f, 32.0f);\n    float bailout = max(fp.params[1], 1.0f);\n    float dBias = max(fp.params[2], 0.01f);\n    float polarRot = fp.params[4];\n    bool applyRot = hasRot1Precomputed(fp);\n\n    float3 z = pos;\n    float3 c = pos;\n    float dr = 1.0f;\n    float r2 = dot(z, z);\n    const float minR2Exit = 1e-12f;\n    float bailout2 = bailout * bailout;\n\n    for (int i = 0; i < iterations && r2 < bailout2 && r2 > minR2Exit; ++i) {\n        float invR = fast::rsqrt(r2 + 1e-6f);\n        float theta = fast::asin(clamp11(z.z * invR)) + polarRot;\n        float phi = fast::atan2(z.y, z.x);\n        float rn = fastPowFromR2(r2, power);\n        dr = fma(rn * power * invR, dr, 1.0f);\n        float thetaP = theta * power;\n        float phiP = phi * power;\n        float cTheta, cPhi;\n        float sTheta = sincos(thetaP, cTheta);\n        float sPhi = sincos(phiP, cPhi);\n        z = rn * float3(cTheta * cPhi, cTheta * sPhi, sTheta) + c;\n        if (applyRot) z = rot * z;\n        r2 = dot(z, z);\n    }\n\n    float r = fast::sqrt(r2);\n    float safeR = max(r, 1e-6f);\n    float de = dBias * 0.5f * safeR * fast::log2(safeR) / max(dr, kEpsLen) * kLn2;\n    if (r > bailout) de = min(de, r - bailout * 0.9f);\n    return de;\n}\n",
    "name": "Embedded Mandelbulb",
